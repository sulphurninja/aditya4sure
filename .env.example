# Copy to .env.local and fill in. Never commit .env.local.

# MongoDB Atlas (or local mongod). Long-term memory lives here — not in the model.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGODB_DB=aditya

# Anthropic — server-only. Content you choose to ask about is sent to Anthropic for reasoning.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (Opus 5.5 default is medium)
ANTHROPIC_EFFORT=medium
# Optional: model that describes photos from imported chats (defaults to ANTHROPIC_MODEL).
# Roughly $0.008/photo on claude-opus-5-5, $0.0002/photo on claude-haiku-5-5.
# ANTHROPIC_MEDIA_MODEL=claude-haiku-5-5

# App sign-in (single owner). Use a long passphrase.
OWNER_PASSPHRASE=change-me-to-a-long-random-passphrase
OWNER_NAME=Aditya Pingle

# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=
# Exactly 32 random bytes, base64 (AES-256-GCM for raw sources / provider tokens):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# Optional: where encrypted photos/wallpapers are stored on disk (never in MongoDB). Back this up with the key.
# MEDIA_DIR=private/media

# Optional: path to the seed knowledge file (defaults to ./aditya-knowledge.json)
# SEED_FILE=./aditya-knowledge.json

# Secret Claude uses to reach the brain over MCP (/api/mcp). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_TOKEN=

# Voice mode (/talk): ElevenLabs Scribe (ears) + Flash TTS (mouth). Leave empty to keep voice off.
ELEVENLABS_API_KEY=
# Optional: any voice id from your ElevenLabs voice library (default: George, a premade voice)
ELEVENLABS_VOICE_ID=
# Optional overrides: ELEVENLABS_TTS_MODEL=eleven_flash_v2_5  ELEVENLABS_STT_MODEL=scribe_v1
# Monthly safety caps so the Creator plan never runs dry
VOICE_MONTHLY_CHAR_CAP=150000
VOICE_MONTHLY_STT_MINUTES=300

# WhatsApp reminders via your Zaptick account (Growth plan). Messages only ever go to OWNER_WHATSAPP.
ZAPTICK_API_KEY=
OWNER_WHATSAPP=+91XXXXXXXXXX
# Public https URL of this app (VPS/tunnel). Needed for voice notes: WhatsApp fetches the audio from here.
PUBLIC_URL=
